# ==============================================================================
# AI RFP Bidder & Proposal Generation System - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your actual credentials:
# cp .env.example .env

# --- LLM API Configuration (Groq Cloud) ---
# Obtain your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Database Configuration (PostgreSQL) ---
# Default for Docker Compose or local PostgreSQL:
DATABASE_URL=postgresql://rfp_user:secure_password@localhost:5432/rfp_bidder
# If running inside docker container via docker-compose:
# DATABASE_URL=postgresql://rfp_user:secure_password@postgres:5432/rfp_bidder

# --- Redis & Celery Background Queue ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Vector Database (ChromaDB) ---
CHROMA_DB_PATH=./chroma_db

# --- Security & JWT (Optional for local testing / production) ---
SECRET_KEY=generate_a_secure_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- App Settings ---
ENVIRONMENT=development
LOG_LEVEL=INFO
